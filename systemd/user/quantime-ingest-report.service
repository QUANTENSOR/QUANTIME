# quantime 每日报告汇总（QNT-45 第 5 项）。
#
# 各源的 daily 运行各自产出 data/reports/<date>/<run_id>.{json,md}；这个 unit 在当天
# 所有源跑完之后汇总一遍，供 owner 一次看全（运行时验收「连续 3 天 coverage=complete」
# 看的就是这些报告）。
#
# **不含任何凭据**，且**不出网**：它只读本地已生成的报告。
#
# 安装由 owner 按 systemd/user/INSTALL.md 逐项执行。本卡只交付文件。

[Unit]
Description=quantime 每日核查报告汇总
Documentation=https://github.com/QUANTENSOR/QUANTIME/blob/main/systemd/user/INSTALL.md

[Service]
Type=oneshot
WorkingDirectory=%h/quantime

# 只读汇总：列出当天 UTC 日期目录下的报告，把每份的整体覆盖打进 journal。
ExecStart=/usr/bin/env sh -c '\
  d="%h/quantime/data/reports/$(date -u +%%Y-%%m-%%d)"; \
  if [ ! -d "$d" ]; then echo "今日无报告目录: $d"; exit 1; fi; \
  for f in "$d"/*.json; do \
    [ -e "$f" ] || { echo "今日无报告文件: $d"; exit 1; }; \
    printf "%%s " "$(basename "$f")"; \
    grep -m1 "\"coverage\"" "$f"; \
  done'

Nice=10
TimeoutStartSec=600
Restart=no

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 汇总只读报告，一个字节都不写——连 data/ 都不给写权限。
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# 不出网：汇总只读本地文件，连 AF_INET 都不需要。
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantime-ingest-report
